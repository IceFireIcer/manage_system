# ===== 本地开发配置（复制为 backend/.env；勿提交真实密钥）=====
# 用法：cp .env.example .env

# 应用环境：dev / test / prod
APP_ENV=dev
DEBUG=true

# 数据库连接：本地开发默认 SQLite（开箱即用）
# 切换本机 MySQL 8.0 时改为（示例，需先建库）：
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/manage_system?charset=utf8mb4
DATABASE_URL=sqlite:///./dev.db
# 可选：迁移使用独立最小权限账号；留空则回退 DATABASE_URL
# MIGRATION_DATABASE_URL=mysql+pymysql://labstock_migrator:password@127.0.0.1:3306/manage_system?charset=utf8mb4

# 登录节流（单进程内存；整班正常登录不受影响）
LOGIN_THROTTLE_ACCOUNT_MAX_ATTEMPTS=5
LOGIN_THROTTLE_ACCOUNT_WINDOW_SECONDS=900
LOGIN_THROTTLE_SOURCE_MAX_ATTEMPTS=100
LOGIN_THROTTLE_SOURCE_WINDOW_SECONDS=300
LOGIN_THROTTLE_BLOCK_SECONDS=300

# 认证日志保留天数与行数上限
AUTH_LOG_RETENTION_DAYS=90
AUTH_LOG_MAX_ROWS=20000

# JWT 认证配置（生产环境请使用至少 32 位随机密钥：openssl rand -hex 32）
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# 首次启动管理员自举（可选；密码留空则随机生成并打印到终端）
ADMIN_INIT_ACCOUNT=admin
ADMIN_INIT_PASSWORD=
ADMIN_INIT_NAME=系统管理员

# LLM 配置（可选，留空则智能补货只使用规则引擎）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat# LLM 供应商 API Key 加密密钥（独立于 JWT；缺失时拒绝保存 Key，可用 openssl rand -hex 32 生成）
SETTINGS_ENCRYPTION_KEY=