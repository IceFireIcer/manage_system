# ===== docker compose 生产部署配置（复制为仓库根 .env 后修改；勿提交真实密钥）=====
# 用法：cp .env.example .env && chmod 600 .env && 编辑 .env
# 正式部署（APP_ENV=prod）下，后端会校验 JWT_SECRET_KEY 与数据库凭据；占位或缺失将拒绝启动。
# 演示/联调可设 APP_ENV=demo，此时允许占位配置且 Cookie 不带 Secure，请勿用于正式环境。

# MySQL root 密码（生产必填；建议只用字母数字与 -_ 等 URL 安全字符，含 @ # / 等需 URL 编码）
MYSQL_ROOT_PASSWORD=change-me-strong-db-password

# JWT 签名密钥（生产必填；生成：openssl rand -hex 32；少于 32 位或含 change-me 视为占位）
JWT_SECRET_KEY=change-me-32-or-more-random-characters

# 应用环境：prod（正式，强制 HTTPS/Secure Cookie 与密钥校验）/ demo（演示，可 HTTP 且 Cookie 不带 Secure）
APP_ENV=prod

# 允许的来源主机（逗号分隔，留空不限制；正式建议填写公网域名）
TRUSTED_HOSTS=

# 可信反向代理来源网段（逗号分隔，支持 CIDR；仅这些来源的 X-Forwarded-Proto 会被采信）
TRUSTED_PROXIES=172.16.0.0/12

# 首次启动自动创建的管理员（可选；密码留空则随机生成并打印到 docker compose logs backend）
# 注意：仅对首次创建生效，已有管理员账号时不会重置密码。
ADMIN_INIT_ACCOUNT=admin
ADMIN_INIT_PASSWORD=
ADMIN_INIT_NAME=系统管理员

# LLM（可选，留空则智能补货降级为规则模板）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 对外 HTTP 端口（默认 4900；HTTPS 叠加文件下 80 会 301 跳转到 443）
WEB_PORT=4900

# 对外 HTTPS 端口（叠加 docker-compose.https.yml 时生效，默认 443）
HTTPS_PORT=443

# 镜像版本标签（升级/回滚时切换，如 v20261127-1）
IMAGE_TAG=latest

# 说明：
# 1. DATABASE_URL 由 docker-compose.yml 依据 MYSQL_ROOT_PASSWORD 自动拼接，云端无需手填。
# 2. 本地零 Docker 开发时，改的是 backend/.env（SQLite 或本机 MySQL），与本文件无关。
# 3. backend/.env.example 提供本地开发用占位配置。
# 4. 管理员初始密码获取与修改见 README「管理员初始化」。
# 5. 正式 HTTPS：将证书放入 ./certs（fullchain.pem、privkey.pem），用
#    docker compose -f docker-compose.yml -f docker-compose.https.yml up -d 启动，详见 docs/deploy.md 5.1。