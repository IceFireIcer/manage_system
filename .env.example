# ===== docker compose 部署配置（复制为仓库根 .env 后修改；勿提交真实密钥）=====
# 用法：cp .env.example .env && 编辑 .env

# MySQL root 密码（请使用字母数字与 -_ 等 URL 安全字符；含 @ # / 等需 URL 编码）
MYSQL_ROOT_PASSWORD=change-me-strong-db-password

# JWT 签名密钥（生成：openssl rand -hex 32）
JWT_SECRET_KEY=change-me-32-or-more-random-characters

# LLM（可选，留空则智能补货降级为规则模板）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 对外 HTTP 端口
WEB_PORT=80

# 镜像版本标签（升级/回滚时切换，如 v20261127-1）
IMAGE_TAG=latest

# 说明：
# 1. DATABASE_URL 由 docker-compose.yml 依据 MYSQL_ROOT_PASSWORD 自动拼接，云端无需手填。
# 2. 本地零 Docker 开发时，改的是 backend/.env（SQLite 或本机 MySQL），与本文件无关。
# 3. backend/.env.example 提供本地开发用占位配置。